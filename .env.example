# Copier ce fichier en .env (jamais commité) et adapter.
CICD_MODE=mock                 # mock | github
DRY_RUN=true                   # true = aucune action réelle, simulation seulement
AUTO_ACTIONS=true              # autorise les actions à risque faible/moyen sans validation
CONFIDENCE_THRESHOLD=0.70      # en dessous : validation humaine obligatoire
MAX_RETRIES=2                  # nombre max de relances automatiques par run
MAX_LOG_CHARS=20000            # logs tronqués (on garde la fin) avant analyse
AUDIT_DB=data/audit.db

# Optionnel : explications générées par un LLM (sinon mode règles seul)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Uniquement si CICD_MODE=github
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_ROLLBACK_WORKFLOW=rollback.yml
